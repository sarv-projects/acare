{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs ruff on any Python file when saved, flagging syntax errors, unused imports, and style issues",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "ruff check ${file}"
  }
}