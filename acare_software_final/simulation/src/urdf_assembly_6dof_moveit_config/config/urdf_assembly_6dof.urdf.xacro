<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="urdf_assembly_6dof">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import urdf_assembly_6dof urdf file -->
    <xacro:include filename="$(find urdf_assembly_6dof_description)/urdf/urdf_assembly_6dof.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="urdf_assembly_6dof.ros2_control.xacro" />


    <xacro:urdf_assembly_6dof_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
