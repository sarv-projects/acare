<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="urdf_assembly_6dof_ros2_control" params="name initial_positions_file">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="base">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['base']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="shoulder">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="elbow">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['elbow']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_1">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_2">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="wrist_3">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="gripper_slider_right">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper_slider_right']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>

        <!-- Gazebo ros2_control plugin -->
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find urdf_assembly_6dof_moveit_config)/config/ros2_controllers.yaml</parameters>
            </plugin>
        </gazebo>

        <!-- RGB-D Camera sensor on camera_link -->
        <gazebo reference="camera_link">
            <sensor name="rgbd_camera" type="rgbd_camera">
                <always_on>true</always_on>
                <update_rate>12</update_rate>
                <camera>
                    <horizontal_fov>1.289</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.2</near>
                        <far>4.0</far>
                    </clip>
                    <depth_camera>
                        <clip>
                            <near>0.2</near>
                            <far>4.0</far>
                        </clip>
                    </depth_camera>
                </camera>
                <topic>/camera</topic>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
